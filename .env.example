# ─── Portal UNIC ────────────────────────────────────────────
PORTAL_URL=https://alunodigital.unic.br/pda_unic
AUTH_URL=https://login.unic.br/
PORTAL_USERNAME=SEU_CPF_SEM_PONTOS
PORTAL_PASSWORD=SUA_SENHA

# ─── Browser ─────────────────────────────────────────────────
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=80
BROWSER_TIMEOUT=30000

# ─── Sessão ──────────────────────────────────────────────────
SESSION_FILE_PATH=./logs/session.json

# ─── LLM — uso local direto ──────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_PRIMARY=gpt-4o-mini
LLM_MODEL_FALLBACK=gpt-4o
LLM_CONFIDENCE_THRESHOLD=0.75

# ─── LLM — proxy VPS (distribuição .exe) ─────────────────────
# Quando preenchido, PROXY_URL tem prioridade sobre as keys acima.
# Deixe vazio para uso local com keys diretas.
PROXY_URL=
PROXY_TOKEN=

# ─── Evolution engine ─────────────────────────────────────────
PERF_WINDOW_SIZE=5
PERF_ACCURACY_THRESHOLD=0.70

# ─── Logs ────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FILE=./logs/educator.jsonl
